{
  "name": "@bloxwap/icons",
  "version": "0.1.1",
  "description": "Bloxwap's curated vector icons, shared by React and React Native.",
  "type": "module",
  "license": "ISC AND MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "svg",
    "LICENSE",
    "NOTICE",
    "README.md",
    "usage.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./native/*": {
      "types": "./dist/native/*.d.ts",
      "default": "./dist/native/*.js"
    },
    "./definitions/*": {
      "types": "./dist/definitions/*.d.ts",
      "default": "./dist/definitions/*.js"
    },
    "./svg/*": "./svg/*",
    "./manifest": "./dist/manifest.json",
    "./package.json": "./package.json",
    "./usage": "./usage.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/generate.mjs --check && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-native": ">=0.81 <1",
    "expo-image": ">=3 <4 || >=55 <59"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.25.12",
    "expo-image": "58.0.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "sharp": "0.35.5",
    "svgo": "4.0.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bloxwap/icons.git",
    "directory": "packages/icons"
  }
}
